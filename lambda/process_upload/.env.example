# AWS Lambda environment (console)
RAW_PREFIX=raw/
THUMB_PREFIX=thumb/
AI_READY_PREFIX=ai-ready/
REJECTED_PREFIX=rejected/

THUMB_MAX_EDGE=400
AI_READY_MAX_WIDTH=1920
AI_READY_MAX_HEIGHT=1080

# Optional — notify teammate C for ML after media processing
GCP_CALLBACK_URL=https://your-cloud-run.app/ingest
GCP_DEDUP_URL=
# Lambda uses /tmp/.dedup_cache.json automatically; override only if needed
# DEDUP_CACHE_PATH=/tmp/.dedup_cache.json
