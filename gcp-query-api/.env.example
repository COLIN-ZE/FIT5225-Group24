DETECTIONS_COLLECTION=detections
ALLOWED_ORIGIN=http://localhost:5173

# Firestore field mapping. Change these after member C finalises the schema.
FIELD_FILE_ID=file_id
FIELD_FILE_NAME=file_name
FIELD_FILE_KEY=file_key
FIELD_IMAGE_URL=image_url
FIELD_THUMBNAIL_URL=thumbnail_url
FIELD_THUMBNAIL_KEY=thumbnail_key
FIELD_SPECIES=species
FIELD_COMMON_NAME=common_name
FIELD_CONFIDENCE=confidence
FIELD_COUNT=count
FIELD_TAGS=tags
FIELD_CREATED_AT=created_at

# Optional: only needed if this function deletes S3 originals/thumbnails directly.
AWS_S3_BUCKET=
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
