DETECTIONS_COLLECTION=media
SUBSCRIPTIONS_COLLECTION=subscriptions
ALLOWED_ORIGIN=http://localhost:5173

# Optional final-deployment guard. Set this in Cloud Functions and configure
# AWS API Gateway to inject the same value as X-Gateway-Secret.
# Leave empty during early local testing.
GATEWAY_SHARED_SECRET=

# C's deletion endpoint. If set, DELETE /files/{fileId} delegates deletion to this URL.
MEDIA_DELETE_URL=
MEDIA_DELETE_SHARED_SECRET=

# media collection schema from member C.
FIELD_FILE_ID=file_id
FIELD_FILE_KEY=file_key
FIELD_USER_ID=user_id
FIELD_FILE_TYPE=file_type
FIELD_FILE_URL=file_url
FIELD_THUMBNAIL_URL=thumbnail_url
FIELD_TAGS=tags
FIELD_AUTO_TAGS=auto_tags
FIELD_MANUAL_TAGS=manual_tags
FIELD_ALL_TAGS=all_tags
FIELD_DETECTIONS=detections
FIELD_AI_READY_URIS=ai_ready_uris
FIELD_STATUS=status
FIELD_CREATED_AT=created_at
FIELD_UPDATED_AT=updated_at

# subscriptions collection schema from member C.
FIELD_SUB_USER_ID=user_id
FIELD_SUB_EMAIL=email
FIELD_SUB_TAGS=tags
FIELD_SUB_STATUS=status
FIELD_SUB_CREATED_AT=created_at
FIELD_SUB_UPDATED_AT=updated_at

# Optional fallback only. Preferred flow is MEDIA_DELETE_URL handled by C.
AWS_S3_BUCKET=
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Used when query responses convert Firestore s3:// or raw/thumb keys into
# browser-readable HTTPS presigned GET URLs.
AWS_PRESIGNED_URL_TTL=3600
